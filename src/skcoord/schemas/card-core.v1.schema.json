{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skworld.io/schemas/card-core.v1.json",
  "title": "SKCoord card core",
  "description": "Tier-one write contract for immutable CardStore birth facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "description",
    "created_by",
    "created_at",
    "acceptance_criteria",
    "dependencies",
    "initial_priority",
    "initial_swimlane",
    "initial_labels",
    "meta"
  ],
  "properties": {
    "id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$",
          "description": "Standard card identifier."
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{12}$",
          "description": "Incident-class identifier."
        }
      ]
    },
    "kind": {
      "enum": ["task", "incident", "epic", "change", "problem"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "initial_priority": {
      "enum": ["critical", "high", "medium", "low"]
    },
    "initial_swimlane": {
      "enum": ["feature", "expedite", "security", "change", "bug", "problem"]
    },
    "initial_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "meta": {
      "type": "object"
    }
  }
}
